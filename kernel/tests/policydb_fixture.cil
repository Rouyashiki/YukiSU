(class file (read write execute entrypoint open map))
(class process (transition dyntransition fork setcurrent execmem))
(class dir (read search open))
(common file_common (getattr))
(classcommon file file_common)
(classorder (file process dir))
(sid kernel)
(sidorder (kernel))
(user u)
(role r)
(type t)
(type target)
(roletype r t)
(roletype r target)
(userrole u r)
(sensitivity s0)
(sensitivityorder (s0))
(category c0)
(categoryorder (c0))
(sensitivitycategory s0 (c0))
(level low (s0))
(level high (s0 (c0)))
(userlevel u low)
(userrange u (low high))
(context kernel_context (u r t (low high)))
(sidcontext kernel kernel_context)
(allow t target (file (read open getattr map)))
(allow t t (process (fork)))
(boolean gate true)
(booleanif gate (true (allow t target (file (write)))))
(typetransition t target file target)
(genfscon proc / (u r t (low high)))
(typepermissive t)
(policycap network_peer_controls)
